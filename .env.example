AI_SERVICE_KEY=replace-with-a-random-secret
AI_CALLBACK_SECRET=replace-with-a-different-random-secret
# URL nội bộ của NestJS trên Render, ví dụ http://chicken-api-xxxx:10000/internal/ai/result
AI_CALLBACK_URL=http://your-nest-service:10000/internal/ai/result

S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=chicken-case
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Model ONNX được version cùng service, không cần Hugging Face hoặc PyTorch.
AI_MODEL_PATH=forWeb.onnx
AI_MODEL_META_PATH=forWeb_meta.json
AI_MODEL_VERSION=forWeb-onnx-v1
AI_THREADS=2
